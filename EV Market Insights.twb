    <worksheet name='04 Top 10 manufacturers by reported sales'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17324d' fontsize='11'>04 Top 10 manufacturers by reported sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='EV Market Dataset' name='federated.0u39pl6100o7j11bu33xb086reur' />
          </datasources>
          <datasource-dependencies datasource='federated.0u39pl6100o7j11bu33xb086reur'>
            <column caption='Dataset records' datatype='integer' name='[Record Count]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Share of dataset sales' datatype='real' name='[Sales Share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([annual_sales_units]) / MIN({ FIXED : SUM([annual_sales_units]) })' />
            </column>
            <column caption='Reported annual sales units' datatype='real' name='[annual_sales_units]' role='measure' type='quantitative' />
            <column-instance column='[customer_rating]' derivation='Avg' name='[avg:customer_rating:qk]' pivot='key' type='quantitative' />
            <column caption='Customer rating out of 5' datatype='real' name='[customer_rating]' role='measure' type='quantitative' />
            <column caption='Manufacturer' datatype='string' name='[manufacturer]' role='dimension' type='nominal' />
            <column-instance column='[manufacturer]' derivation='None' name='[none:manufacturer:nk]' pivot='key' type='nominal' />
            <column-instance column='[Record Count]' derivation='Sum' name='[sum:Record Count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[annual_sales_units]' derivation='Sum' name='[sum:annual_sales_units:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales Share]' derivation='User' name='[usr:Sales Share:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0u39pl6100o7j11bu33xb086reur].[manufacturer]'>
            <groupfilter function='union'>
              <groupfilter function='member' level='[manufacturer]' member='&quot;AmpereWorks&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;SurgeWorks&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;CircuitWorks&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;WattRides&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;IonAutomotive&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;CurrentMobility&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;ElektraMobility&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;VoltAutomotive&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;VoltMobility&quot;' />
              <groupfilter function='member' level='[manufacturer]' member='&quot;VoltWorks&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0u39pl6100o7j11bu33xb086reur].[manufacturer]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Arial' />
            <format attr='font-size' value='9' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <tooltip column='[federated.0u39pl6100o7j11bu33xb086reur].[avg:customer_rating:qk]' />
              <tooltip column='[federated.0u39pl6100o7j11bu33xb086reur].[sum:Record Count:qk]' />
              <tooltip column='[federated.0u39pl6100o7j11bu33xb086reur].[sum:annual_sales_units:qk]' />
              <tooltip column='[federated.0u39pl6100o7j11bu33xb086reur].[usr:Sales Share:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
